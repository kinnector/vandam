{
  "description": "Sensitive credentials and configurations monitored on Linux with ownership and limit rules specifically for Vandam (Server Agent).",
  "credentials": [
    { "pattern": "/.ssh/", "allowed_executables": ["ssh", "git", "ssh-add"], "max_reads": 0 },
    { "pattern": "/id_rsa", "allowed_executables": ["ssh", "git", "ssh-add"], "max_reads": 0 },
    { "pattern": "/id_dsa", "allowed_executables": ["ssh", "git", "ssh-add"], "max_reads": 0 },
    { "pattern": "/id_ecdsa", "allowed_executables": ["ssh", "git", "ssh-add"], "max_reads": 0 },
    { "pattern": "/id_ed25519", "allowed_executables": ["ssh", "git", "ssh-add"], "max_reads": 0 },
    { "pattern": "/.docker/config.json", "allowed_executables": [], "max_reads": 0 },
    { "pattern": "/.npmrc", "allowed_executables": ["npm", "yarn", "pnpm", "node"], "max_reads": 2 },
    { "pattern": "/.aws/", "allowed_executables": ["aws"] },
    { "pattern": "/.gitconfig", "allowed_executables": ["git"] },
    { "pattern": "/.git-credentials", "allowed_executables": ["git"] },
    { "pattern": "/.pypirc", "allowed_executables": ["twine", "pip"] },
    { "pattern": "/.pip/", "allowed_executables": ["pip", "pip3", "poetry", "pipenv"] },
    { "pattern": "/.kube/", "allowed_executables": ["kubectl", "helm"] },
    { "pattern": "var/run/secrets/kubernetes.io/", "allowed_executables": [] },
    { "pattern": "etc/kubernetes/", "allowed_executables": [] },
    { "pattern": "/.config/gcloud/", "allowed_executables": ["gcloud"] },
    { "pattern": "/.gnupg/", "allowed_executables": ["gpg"] },
    { "pattern": "/.cargo/credentials", "allowed_executables": ["cargo"], "max_reads": 2 },
    { "pattern": "/.cargo/credentials.toml", "allowed_executables": ["cargo"], "max_reads": 2 },
    { "pattern": "/.config/gh/", "allowed_executables": ["gh", "git-hub"] },
    { "pattern": "/.gem/credentials", "allowed_executables": ["gem", "bundle"] },
    { "pattern": "/.vault-token", "allowed_executables": ["vault"] },
    { "pattern": "/etc/shadow", "allowed_executables": [] },
    { "pattern": "exodus", "allowed_executables": [] },
    { "pattern": ".keyring", "allowed_executables": [] },
    { "pattern": "kwallet", "allowed_executables": [] }
  ]
}
