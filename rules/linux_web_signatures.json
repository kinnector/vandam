      "config_rules": [
        { "role": "listen_port",  "regex": "^\\s*bind\\s+[^:]*:(\\d+)" },
        { "role": "cluster_peer", "regex": "^\\s*server\\s+\\S+\\s+([\\d\\.]+):" },
        { "role": "tls_cert",     "regex": "^\\s*bind\\s+.*ssl\\s+crt\\s+([^\\s]+)" }
