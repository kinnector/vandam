      "cmdline_tokens": [],
      "default_ports": [8080, 3000],
      "fd_signatures": [],
      "assigned_profile": "restricted-execution",
      "config_location": {
        "cmdline_arg": null,
        "default_paths": ["config.yaml", "config.yml", ".env"]
      },
      "config_rules": [
        { "role": "write_path", "regex": "^log[_-]?(?:path|dir|file)\\s*[=:]\\s*(.+)" },
        { "role": "write_path", "regex": "^storage[_-]?(?:path|dir)\\s*[=:]\\s*(.+)" },
