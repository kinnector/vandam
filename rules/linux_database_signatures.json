      "cmdline_tokens": ["-D"],
      "binary_strings": [],
      "config_location": {
        "cmdline_arg": "--config-file",
        "default_paths": ["/etc/postgresql/postgresql.conf", "/var/lib/pgsql/data/postgresql.conf"],
        "datadir_from_cmdline": "-D"
      },
      "config_rules": [
        { "role": "data_dir",   "regex": "^data_directory\\s*=\\s*'([^']+)'" },
        { "role": "write_path", "regex": "^log_directory\\s*=\\s*'([^']+)'" },
        { "role": "write_path", "regex": "^archive_command\\s*=\\s*'([^']+)'" },
        { "role": "tls_cert",   "regex": "^ssl_cert_file\\s*=\\s*'([^']+)'" },
        { "role": "tls_cert",   "regex": "^ssl_key_file\\s*=\\s*'([^']+)'" }
      ],
      "complexity_indicators": ["archive_command", "restore_command"]
    },
